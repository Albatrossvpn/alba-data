# Fonts never change under the same name; images and icons are kept a day
# (an image that changes for good gets a new name, or waits a day). Pages,
# styles and scripts stay checked on every visit, so a change shows at once.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=86400
/icon.svg
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

